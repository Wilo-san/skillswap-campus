{
  "name": "skillswap-campus",
  "version": "2.0.0",
  "private": true,
  "description": "Plateforme d'échange de compétences entre étudiants, avec banque de temps (1 crédit = 1 heure)",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "setup": "npm --prefix backend install && npm --prefix frontend install",
    "dev:api": "npm --prefix backend run dev",
    "dev:web": "npm --prefix frontend run dev",
    "db:migrate": "npm --prefix backend run db:migrate",
    "db:seed": "npm --prefix backend run db:seed",
    "db:reset": "npm --prefix backend run db:reset",
    "test": "npm --prefix backend run test",
    "build": "npm --prefix frontend run build",
    "start:api": "npm --prefix backend run start"
  }
}
