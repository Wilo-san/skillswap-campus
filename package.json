{
  "name": "skillswap-campus",
  "version": "2.0.0",
  "private": true,
  "description": "Banque de temps entre etudiants : un credit = une heure. Projet GL & Modelisation UML, EST Beni Mellal.",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c cyan,magenta \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm --workspace server run dev",
    "dev:client": "npm --workspace client run dev",
    "build": "npm --workspace client run build",
    "start": "npm --workspace server run start",
    "seed": "npm --workspace server run seed",
    "reset": "npm --workspace server run reset",
    "test": "node server/test/regles.test.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.0"
  },
  "engines": {
    "node": ">=18"
  }
}
