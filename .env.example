# Port du serveur API (et de l interface compilee)
PORT=3001

# Secret de signature des tokens JWT : generer une valeur longue et aleatoire en production
JWT_SECRET=changez-moi-avec-une-chaine-aleatoire-longue

# Dossier de stockage de la base JSON (optionnel, par defaut server/data)
# DATA_DIR=/var/lib/skillswap

# En developpement uniquement : cible du proxy Vite
# API_URL=http://localhost:3001
