# ============================================================
# SkillSwap Campus — variables d'environnement
# Copiez ce fichier vers backend/.env puis adaptez les valeurs.
# ============================================================

# --- Base de données PostgreSQL ---
# Format : postgresql://UTILISATEUR:MOT_DE_PASSE@HOTE:PORT/NOM_DE_LA_BASE
DATABASE_URL="postgresql://skillswap:skillswap@localhost:5432/skillswap"

# --- Sécurité ---
# Clé de signature des jetons JWT : 32 caractères minimum, valeur unique et secrète.
# Générez-en une avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET="remplacez-cette-valeur-par-une-cle-secrete-de-32-caracteres-minimum"
JWT_EXPIRES_IN="8h"

# --- API ---
PORT=4000
NODE_ENV=development
# Origines autorisées pour le frontend (séparées par des virgules)
CORS_ORIGIN="http://localhost:5173"

# --- Données de démonstration (utilisées uniquement par le script de seed) ---
SEED_PASSWORD="Demo1234"
ADMIN_PASSWORD="Admin1234"
